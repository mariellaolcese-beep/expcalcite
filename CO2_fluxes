library(ggplot2)
library(dplyr)
library(tidyr)

# 1. Configuración de directorio y carga de datos
setwd("C:/Experimentcalcite/data")
co2_data <- read.csv("co2_data.csv", fileEncoding = "UTF-8-BOM")
names(co2_data) <- c("SAMPLE", "TIME", "SITE", "STAGE", "TREATMENT", "CO2_ppm")

# Palette
col_D <- "#B08968"  # Dry
col_W <- "#4A7C82"  # Wet

# Constantes físicas
R_gas <- 0.0820573           # L*atm/(mol*K)
T_kelvin <- 298.15           # 25°C
P_atm <- 1.0
V_headspace_L <- 0.076       # 76 mL
A_sedimento_m2 <- 0.00196    #DIAMETRO 50mm  r = 2.5 cm -> A = π*r² = 19.6 cm² = 0.00196 m²
incubation_time_h <- 24

# Función de conversión de ppm a flujo
ppm_to_flux <- function(delta_ppm) {
  delta_C_mol <- (delta_ppm * 1e-6) * (P_atm * V_headspace_L) / (R_gas * T_kelvin)
  return((delta_C_mol * 1e6) / (incubation_time_h * A_sedimento_m2))
}

# 2. Cálculo de flujos por muestra
co2_flux_samples <- co2_data %>%
  mutate(REPLICATE_ID = gsub("(T\\d+)[IF](-.*)", "\\1\\2", SAMPLE)) %>%
  select(REPLICATE_ID, TIME, SITE, TREATMENT, STAGE, CO2_ppm) %>%
  pivot_wider(names_from = STAGE, values_from = CO2_ppm) %>%
  rename(CO2_initial = `I`, CO2_final = `F`) %>%
  mutate(
    delta_ppm = CO2_final - CO2_initial,
    flux_umol_m2_h = ppm_to_flux(delta_ppm)
  )

# 3. Resumen estadístico
etiquetas_tiempo_todas <- c("t0\n(0d)", "t1\n(14d)", "t2\n(30d)", "t3\n(60d)", "t4\n(120d)")

co2_summary <- co2_flux_samples %>%
  group_by(TIME, SITE, TREATMENT) %>%
  summarise(
    mean_flux = mean(flux_umol_m2_h, na.rm = TRUE),
    sd_flux   = sd(flux_umol_m2_h, na.rm = TRUE),
    .groups   = "drop"
  ) %>%
  mutate(
    site        = factor(SITE, levels = c("A", "B"), labels = c("Site Low OM", "Site High OM")),
    time_factor = factor(TIME, levels = 0:4, labels = etiquetas_tiempo_todas),
    treatment   = factor(TREATMENT, levels = c("D", "W"), labels = c("Dry", "Wet"))
  ) %>%
  complete(site, time_factor = factor(etiquetas_tiempo_todas, levels = etiquetas_tiempo_todas), treatment)

# 4. Construcción del gráfico (con ggplot inicial)
p_co2 <- ggplot() +
  # Barras de flujos observados
  geom_col(
    data = co2_summary,
    aes(x = time_factor, y = mean_flux, fill = treatment, group = treatment),
    position = position_dodge(width = 0.7),
    width = 0.45,
    alpha = 0.9,
    na.rm = TRUE
  ) +
  # Barras de error
  geom_errorbar(
    data = co2_summary,
    aes(x = time_factor, ymin = mean_flux - sd_flux, ymax = mean_flux + sd_flux, group = treatment),
    position = position_dodge(width = 0.7),
    width = 0.15,
    linewidth = 0.5,
    color = "black",
    na.rm = TRUE
  ) +
  facet_wrap(~ site) +
  scale_fill_manual(values = c(Dry = col_D, Wet = col_W), name = "Treatment", drop = FALSE) +
  labs(
    title = expression(bold("CO"[2]*" Efflux Rate (Headspace)")),
    subtitle = "Solid bars: Measured mean ± SD",
    x = "Time",
    y = expression(bold("CO"[2]*" Flux ["*mu*"mol C m"^-2*" h"^-1*"]"))
  ) +
  theme_bw(base_size = 13) +
  theme(
    plot.title = element_text(face = "bold", size = 16, hjust = 0.5),
    plot.subtitle = element_text(size = 11, hjust = 0.5, color = "gray30", margin = margin(b = 10)),
    panel.background = element_rect(fill = "white", color = NA),
    panel.grid.major = element_line(color = "gray90", linewidth = 0.5),
    panel.grid.minor = element_line(color = "gray95", linewidth = 0.25),
    panel.border = element_blank(),
    axis.line = element_line(color = "black", linewidth = 0.5),
    strip.background = element_rect(fill = "gray92", color = NA),
    strip.text = element_text(face = "bold", size = 12),
    axis.title = element_text(face = "bold"),
    axis.text = element_text(color = "black"),
    legend.position = "top"
  )

# Mostrar gráfico
print(p_co2)
