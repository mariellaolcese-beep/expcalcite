# ==== Ω (SI) y Ca del agua — SOLO WET — OL y PW ====
# Requiere: pl, num(), y las librerías de tu script (dplyr, ggplot2, tidyr).
# Constantes a 24 °C. Aproximado: sirve para comparar tiempos, no como valor absoluto.
library(tidyr)

omega_calcita <- function(pH, DIC_mM, Ca_mM, Mg_ppm, Na_ppm,
                          pK1 = 6.35, pK2 = 10.34, pKsp = 8.48) {
  I  <- (3*Ca_mM + 3*Mg_ppm/24.305 + Na_ppm/22.99) / 1000
  s  <- sqrt(I)
  g2 <- 10^(-0.509 * 4 * (s/(1 + s) - 0.3*I))
  H  <- 10^(-pH); K1 <- 10^(-pK1); K2 <- 10^(-pK2)
  a2 <- 1 / (1 + H/K2 + H^2/(K1*K2))
  g2^2 * (DIC_mM/1000 * a2) * (Ca_mM/1000) / 10^(-pKsp)
}

# 1) Tabla larga: una fila por botella y compartimento (OL, PW), solo Wet
base <- pl %>%
  transmute(
    sample_id,
    tiempo = as.integer(gsub("\\D", "", extraction_time)),
    stage  = factor(tolower(stage), levels = c("initial", "final")),
    trt    = factor(treatment, levels = c("Dry", "Wet")),
    site   = factor(site, levels = c("A", "B")),
    OL_pH = num(pH_OL), OL_DIC = num(DIC_OL_mM), OL_Ca = num(Ca_OL_mM),
    OL_Mg = num(Mg_OL_ppm), OL_Na = num(Na_OL_ppm), OL_d13 = num(`13DIC_OL_δ`),
    CO2_ppm = num(CO2_corrected_ppm), d13CO2 = num(`13_CO2_δ`),
    PW_pH = num(pH_PW), PW_DIC = num(DIC_PW_mM), PW_Ca = num(Ca_PW_mM),
    PW_Mg = num(Mg_PW_ppm), PW_Na = num(Na_PW_ppm), PW_d13 = num(`13DIC_PW_δ`)
  ) %>%
  filter(trt == "Wet", !is.na(site), !is.na(tiempo), !is.na(stage))

mk <- function(d, pre, nombre) {
  tibble(sample_id = d$sample_id, tiempo = d$tiempo, stage = d$stage, site = d$site,
         comp = nombre,
         Ca_mM = d[[paste0(pre, "_Ca")]],
         DIC_mM = d[[paste0(pre, "_DIC")]],
         d13DIC = d[[paste0(pre, "_d13")]],
         pH = d[[paste0(pre, "_pH")]],
         Na_ppm = d[[paste0(pre, "_Na")]],
         Mg_ppm = d[[paste0(pre, "_Mg")]],
         CaNa = d[[paste0(pre, "_Ca")]] / (d[[paste0(pre, "_Na")]] / 22.99),
         CaMg = d[[paste0(pre, "_Ca")]] / (d[[paste0(pre, "_Mg")]] / 24.305),
         Omega = if_else(!is.na(d[[paste0(pre, "_DIC")]]) & d[[paste0(pre, "_DIC")]] > 0.5,
                         omega_calcita(d[[paste0(pre, "_pH")]], d[[paste0(pre, "_DIC")]],
                                       d[[paste0(pre, "_Ca")]], d[[paste0(pre, "_Mg")]],
                                       d[[paste0(pre, "_Na")]]), NA_real_))
}
agua <- bind_rows(mk(base, "OL", "OL (overlying water)"), mk(base, "PW", "PW (agua de poro)")) %>%
  mutate(SI = log10(Omega))          # SI = log10(Ω); SI > 0 = sobresaturada

# 2) Revisar: mediana de Ω por compartimento, sitio y tiempo
# Esperado OL: A 4.5/14.8/14.0/8.2/8.4 ; B 3.7/17.5/15.4/5.1/8.7
# Esperado PW: A 5.5/3.0/10.1/1.7/3.9  ; B 8.4/3.2/9.2/1.5/3.3 (t0..t4)
agua %>% group_by(comp, site, tiempo) %>%
  summarise(n = sum(!is.na(Omega)), Omega_mediana = round(median(Omega, na.rm = TRUE), 1),
            .groups = "drop") %>% arrange(comp, site, tiempo)

# 3) Función de figura multi-variable: columnas = sitio (arriba), colores = capa (OL / PW)
col_c <- c("OL (overlying water)" = "#1A1A1A", "PW (agua de poro)" = "#D81B60",
           "Headspace (24 h cerrado)" = "#1A1A1A")
dd <- position_dodge(width = 0.25)
dj <- position_jitterdodge(jitter.width = 0.05, dodge.width = 0.25, seed = 1)
f2 <- function(x) sprintf("%.2f", x)
lab_site <- as_labeller(c(A = "Sitio A (Centre)", B = "Sitio B (Cua)"))

fig_multi <- function(d, vars, etiquetas, titulo) {
  largo <- d %>% pivot_longer(all_of(vars), names_to = "variable", values_to = "valor") %>%
    filter(!is.na(valor)) %>%
    mutate(variable = factor(variable, levels = vars, labels = etiquetas))
  m <- largo %>% group_by(site, comp, variable, tiempo) %>%
    summarise(v = mean(valor), .groups = "drop")
  ggplot(largo, aes(tiempo, valor, color = comp)) +
    geom_point(position = dj, size = 1.2, alpha = 0.6) +
    geom_line(data = m, aes(y = v, group = comp), position = dd, linewidth = 0.6) +
    geom_point(data = m, aes(y = v), position = dd, shape = 18, size = 4) +
    facet_grid(variable ~ site, scales = "free_y", switch = "y", labeller = labeller(site = lab_site)) +
    scale_color_manual(values = col_c, name = "Capa") +
    scale_y_continuous(labels = f2) +
    labs(x = "Tiempo", y = NULL, title = titulo) +
    theme_minimal(base_size = 12) +
    theme(strip.placement = "outside",
          strip.text.y.left = element_text(size = 8, angle = 90),   # nombres de las variables (eje y)
          strip.text.x      = element_text(size = 10),              # nombre del sitio
          axis.text         = element_text(size = 8),
          legend.text       = element_text(size = 9))
}

# Figura 1: Ω del OL y del PW (una fila)
p_omega <- fig_multi(agua, "Omega", "Ω calcita", "Wet: Ω de calcita (OL y PW)")

# Figura 2: carbonato (SI, Ca, DIC, δ13C-DIC, pH)
p_SI_Ca <- fig_multi(agua, c("SI", "Ca_mM", "DIC_mM", "d13DIC", "pH"),
                     c("SI = log10(Ω)", "Ca (mM)", "DIC (mM)", "δ13C-DIC (‰)", "pH"),
                     "Wet: SI, Ca, DIC, δ13C-DIC y pH del agua (OL y PW)")

# Figura 3: iones "conservativos" (Na, Mg) y Ca/Na molar (para separar calcita de otras fuentes)
p_iones <- fig_multi(agua, c("Ca_mM", "SI", "Na_ppm", "Mg_ppm", "CaNa", "CaMg"),
                     c("Ca (mM)", "SI = log10(Ω)", "Na (ppm)", "Mg (ppm)", "Ca/Na (molar)", "Ca/Mg (molar)"),
                     "Wet: Ca, SI, Na, Mg, Ca/Na y Ca/Mg del agua (OL y PW)")

# Figura 4: headspace (CO2 y δ13CO2); no hay OL/PW, es una sola columna
hs <- base %>% transmute(sample_id, tiempo, stage, site, comp = "Headspace (24 h cerrado)",
                         CO2_ppm, d13CO2)
p_CO2 <- fig_multi(hs, c("CO2_ppm", "d13CO2"), c("CO2 (ppm)", "δ13C-CO2 (‰)"),
                   "Wet: CO2 del headspace")

p_omega; p_SI_Ca; p_iones; p_CO2

# ==== 5) D (calcita marcada disuelta, OL) junto a la química — SOLO WET ====
Fresp <- 0.010783151                         # δresp = -25 ‰ (supuesto)
Fcalc <- c(A = 0.015909369, B = 0.014858)    # F de la calcita marcada por sitio

D_b <- pl %>%
  transmute(
    sample_id,
    tiempo = as.integer(gsub("\\D", "", extraction_time)),
    stage  = factor(tolower(stage), levels = c("initial", "final")),
    trt    = factor(treatment, levels = c("Dry", "Wet")),
    site   = factor(site, levels = c("A", "B")),
    C_ol   = num(DIC_OL_bottle_mmol) * 1000,          # µmol C en el OL de la botella
    C_add  = num(DIC_add_vild_total_mmol) * 1000,     # µmol C añadidos con Viladrau (entrada)
    C13_ol = num(`13DIC_OL_bottle_umol`),
    C13_add = num(`13DIC_add_vilad_umol`)
  ) %>%
  filter(trt == "Wet", !is.na(site), !is.na(tiempo), !is.na(stage)) %>%
  mutate(
    C_neto   = C_ol - C_add,
    C13_neto = C13_ol - C13_add,
    D        = (C13_neto - C_neto * Fresp) / (Fcalc[as.character(site)] - Fresp)   # µmol de calcita
  )

# Revisar: medias de D por sitio, tiempo y etapa. Esperado (inicial / final):
# A: t0 3.0/6.2  t1 6.7/4.6  t2 3.0/2.1  t3 -0.6/-1.6  t4 -2.0/-3.1
# B: t0 3.9/5.9  t1 6.0/5.0  t2 3.1/1.0  t3 -0.7/-1.0  t4 -2.0/-4.1
D_b %>% group_by(site, tiempo, stage) %>%
  summarise(D_media = round(mean(D, na.rm = TRUE), 1), n = sum(!is.na(D)), .groups = "drop") %>%
  tidyr::pivot_wider(names_from = stage, values_from = c(D_media, n))

# Delta por botella final = D(final) - media D(inicial) del mismo sitio y tiempo
ref_D <- D_b %>% filter(stage == "initial") %>% group_by(site, tiempo) %>%
  summarise(D_ini = mean(D, na.rm = TRUE), .groups = "drop")
dD <- D_b %>% filter(stage == "final") %>% left_join(ref_D, by = c("site", "tiempo")) %>%
  transmute(sample_id, dD = D - D_ini)

# Figura D1: D por etapa (negro = inicial, rosa = final)
colD <- c(initial = "#1A1A1A", final = "#D81B60")
mD <- D_b %>% filter(!is.na(D)) %>% group_by(site, stage, tiempo) %>%
  summarise(v = mean(D), .groups = "drop")
p_D_etapa <- ggplot(filter(D_b, !is.na(D)), aes(tiempo, D, color = stage)) +
  geom_point(position = dj, size = 1.2, alpha = 0.6) +
  geom_line(data = mD, aes(y = v, group = stage), position = dd, linewidth = 0.6) +
  geom_point(data = mD, aes(y = v), position = dd, shape = 18, size = 4) +
  facet_wrap(vars(site), labeller = labeller(site = lab_site)) +
  scale_color_manual(values = colD, name = "Botella") +
  scale_y_continuous(labels = f2) +
  labs(x = "Tiempo", y = "D (µmol de calcita marcada, OL)",
       title = "Wet: D por etapa (inicial vs final)") +
  theme_minimal(base_size = 12) +
  theme(axis.text = element_text(size = 8), strip.text.x = element_text(size = 10))

# Figura D2: ΔD (24 h) junto a la química del OL (SI, δ13C-DIC, Ca, pH)
ctx <- agua %>% filter(comp == "OL (overlying water)") %>%
  select(sample_id, tiempo, stage, site, comp, SI, d13DIC, Ca_mM, pH) %>%
  left_join(dD, by = "sample_id")
p_D_quimica <- fig_multi(ctx, c("dD", "SI", "d13DIC", "Ca_mM", "pH"),
                         c("ΔD final-inicial (µmol)", "SI = log10(Ω)", "δ13C-DIC (‰)", "Ca (mM)", "pH"),
                         "Wet: ΔD (24 h) y química del OL")

p_D_etapa; p_D_quimica
