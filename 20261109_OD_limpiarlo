library(tidyverse)
library(lubridate)

# ==========================================
# 1. LECTURA 
# ==========================================

ruta_archivo <- "C:/Experimentcalcite/data/SENSORS_OD.csv"

# Leer archivo CSV
od_raw <- read.csv2(ruta_archivo, stringsAsFactors = FALSE)

# Explicar el nombre de las columnas y que lea las fechas:
# 1: ID_sensor, 2: date, 3: treatment, 4: site, 5: replicate, 6: L_M_V, 7: OD_umolL
colnames(od_raw) <- c("ID_sensor", "date", "treatment", "site", "replicate", "L_M_V", "OD_umolL")

od <- od_raw %>%
  mutate(
    # Parsea fechas dinámicamente (D-M-Y o Y-M-D, con o sin hora)
    date = parse_date_time(date, orders = c("dmy", "dmy HMS", "ymd", "ymd HMS")),
    
    # Conversión decimal a número
    OD_umolL = as.numeric(gsub(",", ".", as.character(OD_umolL))),
    
    # Factores
    treatment = factor(treatment),
    site      = factor(site),
    ID_sensor = factor(ID_sensor),
    replicate = factor(replicate),
    L_M_V     = factor(L_M_V, levels = c("L", "M", "V"))
  )

# ==========================================
# 2. Que reconozca los dias: VERIFICAR L_M_V
# ==========================================

# Generar el día (Lunes = 1, Miércoles = 3, Viernes = 5)
od <- od %>%
  mutate(dia_real = case_when(
    wday(date, week_start = 1) == 1 ~ "L",
    wday(date, week_start = 1) == 3 ~ "M",
    wday(date, week_start = 1) == 5 ~ "V",
    TRUE ~ NA_character_
  ))

# Comprobar si existen discrepancias entre el día del calendario y L_M_V
discrepancias <- od %>% 
  filter(is.na(dia_real) | as.character(L_M_V) != dia_real) %>%
  distinct(date, L_M_V, dia_real)

print(discrepancias) # Si todo coincide, dará 0 filas


# ==========================================
# 3. SCREENING GRÁFICO (PASO A PASO)
# ==========================================

# A) General: Comparación Wet vs Dry
ggplot(od, aes(x = date, y = OD_umolL, color = treatment, group = interaction(treatment, site, replicate))) +
  geom_line(alpha = 0.5) +
  geom_point(size = 1.5) +
  labs(
    title = "Screening General: Wet vs Dry",
    x = "Fecha",
    y = expression(OD~(mu*mol/L)),
    color = "Tratamiento"
  ) +
  theme_minimal()

# B) Específico Wet: Sitio A y Sitio B en el mismo gráfico
od %>%
  filter(tolower(treatment) %in% c("wet", "w")) %>%
  ggplot(aes(x = date, y = OD_umolL, color = site, group = interaction(site, ID_sensor, replicate))) +
  geom_line(alpha = 0.6) +
  geom_point(alpha = 0.7) +
  labs(
    title = "Screening Tratamiento Wet: Comparación Sitio A vs Sitio B",
    x = "Fecha",
    y = expression(OD~(mu*mol/L)),
    color = "Sitio"
  ) +
  theme_minimal()

# c) Ahora que solo muestre los puntos promedios entre sitio 
# Específico Wet: Una sola línea promedio por Sitio (A vs B)
od %>%
  filter(tolower(treatment) %in% c("wet", "w")) %>%
  group_by(date, site) %>%
  summarise(OD_umolL = mean(OD_umolL, na.rm = TRUE), .groups = "drop") %>%
  ggplot(aes(x = date, y = OD_umolL, color = site, group = site)) +
  geom_line(linewidth = 1) +
  geom_point(size = 2) +
  labs(
    title = "Screening Tratamiento Wet: Promedio Sitio A vs Sitio B",
    x = "Fecha",
    y = expression(Promedio~OD~(mu*mol/L)),
    color = "Sitio"
  ) +
  theme_minimal()

# Ahora con la desviacion estandar el específico Wet: Promedio y Desviación Estándar por Sitio (A vs B)
od %>%
  filter(tolower(treatment) %in% c("wet", "w")) %>%
  group_by(date, site) %>%
  summarise(
    OD_media = mean(OD_umolL, na.rm = TRUE),
    OD_sd    = sd(OD_umolL, na.rm = TRUE),
    .groups  = "drop"
  ) %>%
  ggplot(aes(x = date, y = OD_media, color = site, fill = site, group = site)) +
  
  # Sombra que representa la Desviación Estándar (Promedio ± SD)
  geom_ribbon(aes(ymin = OD_media - OD_sd, ymax = OD_media + OD_sd), alpha = 0.2, color = NA) +
  geom_line(linewidth = 1) +
  geom_point(size = 2) +
  labs(
    title = "Screening Tratamiento Wet: Promedio y Desviación Estándar",
    subtitle = "Líneas: Promedio | Sombra: ±1 Desviación Estándar",
    x = "Fecha",
    y = expression(Promedio~OD~(mu*mol/L)),
    color = "Sitio",
    fill  = "Sitio"
  ) +
  theme_minimal()

