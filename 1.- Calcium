  guides(color = guide_legend(override.aes = list(shape = 18, size = 4, alpha = 1))) +
  labs(x = NULL, y = "Δ Ca sólido final - initial (mmol en 24 h)",
       title = "Efecto de la incubación de 24 h en el Ca del sedimento",
       subtitle = "Compartimento: sedimento (sólido). Final - Inicial",
       caption = "Puntos pequeños = cada frasco final - media initial; rombo = promedio") +
  tema
print(p_sol2)

# FIGURA S3. MASA de Ca del sedimento a largo plazo (mmol por frasco)
etapa_masa <- "initial"        # "initial" = frascos antes de la incubación de 24 h; cambia a "final" para ver los finales

est_masa <- sol %>%
