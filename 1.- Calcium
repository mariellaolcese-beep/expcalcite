  scale_x_continuous(breaks = 0:4, labels = paste0("t", 0:4)) +
  scale_y_continuous(labels = eje2) +
  scale_color_manual(values = col_site, name = "Sitio") +
  guides(color = guide_legend(override.aes = list(shape = 18, size = 4, alpha = 1))) +
  labs(x = NULL, y = "Ca neto sólido = final - entrada (mmol por frasco)",
       title = "Evolución del Ca en el sedimento, 3 meses",
       subtitle = "Compartimento: sedimento (sólido). Botellas iniciales. Puntos pequeños = cada frasco; rombo = promedio",
       caption = "A = MO baja, B = MO alta.") +
  tema
print(p_sol1)

# FIGURA S2. Delta final - initial: puntos = cada frasco final menos el promedio de los initial, rombo = promedio
p_sol2 <- ggplot() +
  geom_hline(yintercept = 0, linetype = "dashed", color = "grey40", linewidth = 0.4) +
  geom_point(data = pts_delta, aes(tiempo, d_frasco, color = site), position = dj, size = 1.6, alpha = 0.5) +
  geom_line(data = delta_sol, aes(tiempo, d, color = site, group = site), position = dod, linewidth = 0.6) +
