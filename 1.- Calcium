f2 <- function(x) sprintf("%.2f", x)
# Decimales según la magnitud de cada panel: >=100 sin decimales (µM, ppm), >=10 un decimal, menor 2 decimales
eje_auto <- function(x) {
  r <- max(abs(x), na.rm = TRUE)
  d <- if (r >= 100) 0 else if (r >= 10) 1 else 2
  sprintf(paste0("%.", d, "f"), x)
}

fig_multi <- function(d, vars, etiquetas, titulo, columnas = "comp", caption = NULL, escalas = "free_y") {
  largo <- d %>% pivot_longer(all_of(vars), names_to = "variable", values_to = "valor") %>%
    filter(!is.na(valor)) %>%
    mutate(variable = factor(variable, levels = vars, labels = etiquetas))
  m <- largo %>% group_by(across(all_of(c(columnas, "variable", "site", "tiempo")))) %>%
    summarise(v = mean(valor), .groups = "drop")
  ggplot(largo, aes(tiempo, valor, color = site)) +
    geom_point(position = dj, size = 1.2, alpha = 0.6) +
    geom_line(data = m, aes(y = v, group = site), position = dd, linewidth = 0.6) +
    geom_point(data = m, aes(y = v), position = dd, shape = 18, size = 4) +
    facet_grid(as.formula(paste("variable ~", columnas)), scales = escalas, switch = "y") +
    scale_x_continuous(breaks = 0:4, labels = paste0("t", 0:4)) +
    scale_color_manual(values = col_site, name = "Sitio") +
    scale_y_continuous(labels = eje_auto) +
    labs(x = NULL, y = NULL, title = titulo, caption = caption) +
    tema +
    theme(strip.placement = "outside")
}

