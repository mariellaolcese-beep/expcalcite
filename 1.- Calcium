# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#
#                                                                                                         7. PARA EL SÓLIDO
# -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#
eje2 <- function(x) sprintf("%.2f", x)
dj   <- position_jitterdodge(jitter.width = 0.05, dodge.width = 0.25, seed = 1)

sol <- pl %>%
  transmute(
    sample_id,
    tiempo = as.integer(gsub("\\D", "", extraction_time)),
    stage  = factor(tolower(stage), levels = c("initial", "final")),
    trt    = factor(treatment, levels = c("Dry", "Wet")),
    site   = factor(site, levels = c("A", "B")),
    Sed_dry_g      = num(Sed_init_dry_g),
    Ca_sed_ppm     = num(Ca_sed_ppm),
    Ca_sed_mmol    = coalesce(num(Ca_sediment_ST_mmol), (Ca_sed_ppm / M_Ca) * Sed_dry_g / 1000),
    Ca_sed_in_mmol = num(Calcio_sediment_native)
  ) %>%
  filter(!is.na(site), !is.na(trt), !is.na(tiempo), !is.na(stage)) %>%
  group_by(site) %>%
  mutate(Ca_sed_in_mmol = coalesce(Ca_sed_in_mmol, mean(Ca_sed_in_mmol, na.rm = TRUE))) %>%
  ungroup() %>%
  mutate(Ca_neto_sed_mmol = Ca_sed_mmol - Ca_sed_in_mmol)

est_sol <- sol %>%
  group_by(tiempo, site, trt, stage) %>%
  summarise(n  = sum(!is.na(Ca_neto_sed_mmol)),
            m  = mean(Ca_neto_sed_mmol, na.rm = TRUE),
            sd = sd(Ca_neto_sed_mmol, na.rm = TRUE),
            .groups = "drop")

delta_sol <- est_sol %>%
  pivot_wider(names_from = stage, values_from = c(n, m, sd)) %>%
  mutate(d    = m_final - m_initial,
         d_sd = sqrt(sd_final^2 + sd_initial^2)) %>%
  filter(!is.na(d))

# Puntos de cada frasco para el delta: frasco FINAL - promedio de los initial (mismo tiempo, sitio y tratamiento)
base_I_sol <- sol %>% filter(stage == "initial") %>%
  group_by(tiempo, site, trt) %>% summarise(neto_I = mean(Ca_neto_sed_mmol, na.rm = TRUE), .groups = "drop")
pts_delta <- sol %>% filter(stage == "final") %>%
  left_join(base_I_sol, by = c("tiempo", "site", "trt")) %>%
  mutate(d_frasco = Ca_neto_sed_mmol - neto_I) %>%
  filter(!is.na(d_frasco))

# FIGURA S1. Solo los frascos INITIAL: puntos = cada frasco, rombo = promedio
est_ini <- est_sol %>% filter(stage == "initial", !is.na(m), !is.nan(m))
p_sol1 <- ggplot() +
  geom_hline(yintercept = 0, color = "grey60", linewidth = 0.3) +
  geom_point(data = sol %>% filter(stage == "initial", !is.na(Ca_neto_sed_mmol)),
             aes(tiempo, Ca_neto_sed_mmol, color = site), position = dj, size = 1.6, alpha = 0.5) +
  geom_line(data = est_ini, aes(tiempo, m, color = site, group = site), position = dod, linewidth = 0.6) +
  geom_point(data = est_ini, aes(tiempo, m, color = site), position = dod, shape = 18, size = 4.5) +
