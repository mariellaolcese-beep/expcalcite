# --- 1. Import & format ----
import_gas_data <- function(gas_pattern, folder) {
  files <- list.files(folder, pattern = gas_pattern, recursive = TRUE, full.names = TRUE)
  if (length(files) > 0) {
    return(map_dfr(files, ~ read_csv(.x, show_col_types = FALSE)))
  } else {
    return(NULL)
  }
}

n2o <- import_gas_data("^ppm_samples_N2O", folder_results)
co2 <- import_gas_data("^ppm_samples_CO2", folder_results)
ch4 <- import_gas_data("^ppm_samples_CH4", folder_results)

all_list <- list(n2o, co2, ch4)
all_list <- all_list[!sapply(all_list, is.null)]

if (length(all_list) > 0) {
  all <- bind_rows(all_list)
} else {
  stop("No se encontraron archivos de muestras ppm.")
}

# --- 2. Calculations ----
select_lowest_cv <- function(measurements) {
  combos <- combn(measurements, 3, simplify = FALSE)
  cvs <- sapply(combos, function(x) sd(x) / mean(x) * 100)
  best_combo <- combos[[which.min(cvs)]]
  return(best_combo)
}

## Calculate summary with best 3 injections
using3best <- all %>%
  group_by(gas, sample, dayofanalysis) %>%
  mutate(total_injections = sum(!is.na(ppm))) %>% 
  filter(total_injections >= 3) %>% 
  reframe(
    ppm = select_lowest_cv(ppm)
  ) %>% 
  group_by(gas, sample, dayofanalysis) %>% 
  summarise(avg3_ppm = mean(ppm),
            sd3_ppm = sd(ppm), 
            cv3 = sd3_ppm / avg3_ppm,
            n3 = sum(!is.na(ppm)), .groups = "drop")

## Calculate summary with all injections
usingall <- all %>% 
  group_by(gas, sample, dayofanalysis) %>% 
  summarise(avg_ppm = mean(ppm),
            sd_ppm = sd(ppm), 
            cv = sd_ppm / avg_ppm,
            nall = sum(!is.na(ppm)), .groups = "drop")

# --- 3. Format and Save ----
combination <- usingall %>% 
  left_join(using3best, by = c("gas", "sample", "dayofanalysis")) %>% 
  mutate(discarding = !is.na(cv3) & (cv > cv3)) %>% 
  mutate(avg_ppm = if_else(discarding, avg3_ppm, avg_ppm),
         sd_ppm  = if_else(discarding, sd3_ppm, sd_ppm),
         n_used = if_else(discarding, n3, nall),
         n_discarded = if_else(discarding, nall - n3, 0)) %>% 
  select(gas, sample, dayofanalysis, avg_ppm, sd_ppm, n_used, n_discarded) %>% 
  pivot_wider(id_cols = c(sample, dayofanalysis), names_from = gas, names_sep = "_", values_from = c(avg_ppm, sd_ppm, n_used, n_discarded), names_sort = TRUE)

write.csv(combination, paste0(folder_results, "All_Summary_ch4_co2_n2o_best3inj.csv"), row.names = FALSE)

# Save all data per injection
allinjections <- all %>% 
  select(gas, dayofanalysis, sample, ml_injected, peak_id, ppm)

write.csv(allinjections, paste0(folder_results, "All_Injections_ppm_ch4_co2_n2o.csv"), row.names = FALSE)

