# --- 4.1 Gráfico de Líneas (Media ± Error Estándar) ---
plot_delta_lineas <- ggplot(dic_diff, 
                           aes(x = TIME, y = delta_DIC, color = LAYER, group = LAYER)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "gray50", linewidth = 0.8) +
  stat_summary(fun = mean, geom = "line", linewidth = 0.9) +
  stat_summary(fun = mean, geom = "point", size = 2.5) +
  stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2) +
  facet_grid(SITE ~ TREATMENT, labeller = label_both) +
  scale_color_manual(values = c("OL" = "#1f77b4", "PW" = "#ff7f0e")) +
  labs(
    title = "Cambio Neto en DIC (ΔDIC = Final - Inicial) - Tendencia Promedio",
    subtitle = "Media ± Error Estándar (Línea en 0 = Sin Cambio)",
    x = "Tiempo",
    y = "ΔDIC (mM)",
    color = "Capa (LAYER)"
  ) +
  theme_bw() +
  theme(
    plot.title = element_text(face = "bold", size = 13, hjust = 0.5),
    plot.subtitle = element_text(size = 10, hjust = 0.5),
    legend.position = "bottom",
    strip.background = element_rect(fill = "#f0f0f0")
  )

print(plot_delta_lineas)


