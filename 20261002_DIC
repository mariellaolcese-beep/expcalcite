### ============================================================================
### 1. CARGA DE LIBRERÍAS Y PREPARACIÓN DE DATOS (DIC)
### ============================================================================

library(dplyr)
library(tidyr)
library(car)
library(emmeans)
library(ggplot2)

# Cargar el archivo CSV
dic_data <- read.csv("DIC_R.csv", header = TRUE, sep = ";", dec = ",", check.names = FALSE)

# Limpieza y extracción de variables
dic_clean <- dic_data %>%
  select(time, sample, layer, `DIC mM`) %>%
  mutate(
    DIC = as.numeric(gsub(",", ".", as.character(`DIC mM`))),
    STAGE = as.factor(sub("^T\\d+([IF]).*", "\\1", sample)),
    SITE = as.factor(ifelse(
      grepl("-[A-Za-z]{2}\\d", sample),
      sub(".*-([A-Za-z])[A-Za-z]\\d.*", "\\1", sample),
      sub(".*-([A-Za-z])\\d.*", "\\1", sample)
    )),
    TREATMENT = as.factor(ifelse(
      grepl("-[A-Za-z]{2}\\d", sample),
      sub(".*-[A-Za-z]([A-Za-z])\\d.*", "\\1", sample),
      sub(".*-([A-Za-z])\\d.*", "\\1", sample)
    )),
    TIME  = as.factor(time),
    LAYER = as.factor(toupper(layer))
  ) %>%
  filter(!is.na(DIC))


### ============================================================================
### 2. VISIÓN GENERAL: TODOS LOS DATOS (GLOBAL)
### ============================================================================

cat("\n--- Generando Gráfico Global 1: Evolución del DIC (Líneas) ---\n")

plot_dic_lineas_global <- ggplot(dic_clean, 
                                 aes(x = TIME, y = DIC, color = LAYER, group = LAYER)) +
  stat_summary(fun = mean, geom = "line", linewidth = 0.9) +
  stat_summary(fun = mean, geom = "point", size = 2.5) +
  stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2) +
  facet_grid(SITE ~ TREATMENT, labeller = label_both) +
  scale_color_manual(values = c("OL" = "#1f77b4", "PW" = "#ff7f0e")) +
  labs(
    title = "DIC vs Time",
    subtitle = "Comparison OL y PW for Site y Treatment",
    x = "Tiempo",
    y = "DIC (mM)",
    color = "Capa (LAYER)"
  ) +
  theme_bw() +
  theme(
    plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
    plot.subtitle = element_text(size = 11, hjust = 0.5),
    axis.title = element_text(face = "bold"),
    legend.position = "bottom",
    strip.background = element_rect(fill = "#f0f0f0")
  )

print(plot_dic_lineas_global)

cat("\n--- Generando Gráfico Global 2: Medidas Individuales de DIC (Puntos) ---\n")

plot_dic_puntos_global <- ggplot(dic_clean, 
                                 aes(x = TIME, y = DIC, color = LAYER)) +
  geom_point(
    position = position_jitterdodge(jitter.width = 0.15, dodge.width = 0.4),
    size = 2.5, 
    alpha = 0.8
  ) +
  facet_grid(SITE ~ TREATMENT, labeller = label_both) +
  scale_color_manual(values = c("OL" = "#1f77b4", "PW" = "#ff7f0e")) +
  labs(
    title = "Todas las Medidas de DIC por Tiempo (Todos los Datos)",
    subtitle = "Mediciones individuales de OL (Agua Sobrenadante) vs PW (Agua de Poro) por Sitio y Tratamiento",
    x = "Tiempo",
    y = "DIC (mM)",
    color = "Capa (LAYER)"
  ) +
  theme_bw() +
  theme(
    plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
    plot.subtitle = element_text(size = 11, hjust = 0.5),
    axis.title = element_text(face = "bold"),
    legend.position = "bottom",
    strip.background = element_rect(fill = "#f0f0f0")
  )

print(plot_dic_puntos_global)


### ============================================================================
### 3. ETAPA INICIAL (STAGE == 'I')
### ============================================================================

# --- 3.1 Filtrado de datos ---
dic_inicial <- dic_clean %>%
  filter(STAGE == "I")

dic_inicial_W <- dic_inicial %>% 
  filter(TREATMENT == "W")

# --- 3.2 Análisis Estadístico: Normalidad (Shapiro-Wilk) ---
shapiro_inicial <- dic_inicial %>%
  group_by(SITE, LAYER, TREATMENT, TIME) %>%
  summarise(
    n = n(),
    W = ifelse(n >= 3, shapiro.test(DIC)$statistic, NA),
    p_value = ifelse(n >= 3, shapiro.test(DIC)$p.value, NA),
    .groups = "drop"
  ) %>%
  mutate(Normal = ifelse(p_value > 0.05, "SÍ", "NO"))

cat("\n--- Shapiro-Wilk Por Subgrupo (STAGE = 'I') ---\n")
print(as.data.frame(shapiro_inicial))

# --- 3.3 Homocedasticidad (Levene) por Capa ---
cat("\n--- Prueba de Levene (STAGE = 'I') ---\n")
levene_OL_ini <- leveneTest(DIC ~ SITE * TREATMENT * TIME, data = filter(dic_inicial, LAYER == "OL"))
levene_PW_ini <- leveneTest(DIC ~ SITE * TREATMENT * TIME, data = filter(dic_inicial, LAYER == "PW"))

cat("Agua Sobrenadante (OL) - p-value:", levene_OL_ini$`Pr(>F)`[1], "\n")
cat("Agua de Poro (PW)         - p-value:", levene_PW_ini$`Pr(>F)`[1], "\n")

# --- 3.4 Modelos ANOVA y Post-Hoc (Tratamiento W) ---
cat("\n>>> OL (Tratamiento W) - Inicial <<<\n")
mod_OL_W_ini <- aov(DIC ~ SITE * TIME, data = filter(dic_inicial_W, LAYER == "OL"))
print(summary(mod_OL_W_ini))

cat("\n--- Tukey (TIME) en OL (W) - Inicial ---\n")
tukey_OL_W_ini <- emmeans(mod_OL_W_ini, pairwise ~ TIME, adjust = "tukey")
print(tukey_OL_W_ini$contrasts)

cat("\n>>> PW (Tratamiento W) - Inicial <<<\n")
mod_PW_W_ini <- aov(DIC ~ SITE * TIME, data = filter(dic_inicial_W, LAYER == "PW"))
print(summary(mod_PW_W_ini))

cat("\n--- Tukey (TIME) en PW (W) - Inicial ---\n")
tukey_PW_W_ini <- emmeans(mod_PW_W_ini, pairwise ~ TIME, adjust = "tukey")
print(tukey_PW_W_ini$contrasts)

# --- 3.5 Visualización de Tratamiento W (Etapa Inicial 'I') ---
cat("\n--- Generando Gráficos: Etapa Inicial (STAGE I - W) ---\n")

# Gráfico 1: Líneas de medias ± error estándar
plot_dic_lineas_W_I <- ggplot(dic_inicial_W, 
                              aes(x = TIME, y = DIC, color = LAYER, group = LAYER)) +
