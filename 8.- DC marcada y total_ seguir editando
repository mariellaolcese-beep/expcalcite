# Calcita TOTAL disuelta (el otro metodo) por compartimento: OL, PW
# Calcita TOTAL disuelta (marcada + nativa), "mi metodo", solo parte LIQUIDA: OL, PW y total liquido (OL + PW)
# Mismo exceso de 13C que el metodo del tutor, pero dividido por la F de la calcita TOTAL (trazador + nativa):
#   xs = 13C - C * F_fondo        (F_fondo = Viladrau; no se resta Viladrau ni se usa ninguna respiracion)
#   D  = xs / (F_calc - F_fondo)
# D sale en µmol de CaCO3 total (marcada + nativa) disueltos en 24 h, POR BOTELLA.
# Necesita en memoria: `pl` y la funcion `num`
library(dplyr); library(tidyr); library(ggplot2); library(stringr)

F_fondo  <- 0.010878323                # Viladrau, d13C = -16,3 permil
# F de la calcita total por sitio = mezcla trazador + nativa. ACTUALIZADO con: 48 mg (A) y 43 mg (B) de reactivo,
# pureza 0,998, masa seca 17,893 g (A) y 18,778 g (B), 47,8 % de calcita nativa, d13C nativo -4,97 (A) y -3,84 (B), F_marcaje 0,9999
F_calc   <- c(A = 0.016456495, B = 0.015674124)
dias_inc <- 1

d <- pl %>%
  transmute(
    sample_id,
    tiempo = as.integer(str_extract(extraction_time, "\\d+")),
    stage  = factor(tolower(stage), levels = c("initial", "final")),
    trt    = factor(treatment, levels = c("Dry", "Wet")),
    site   = factor(site, levels = c("A", "B")),
    Sed_dry_g = num(Sed_init_dry_g),
    C_OL  = num(DIC_OL_bottle_mmol) * 1000,  C13_OL = num(`13DIC_OL_bottle_umol`),     # umol medidos en la botella
    C_PW  = num(DIC_PW_bottle_mmol) * 1000,  C13_PW = num(`13DIC_PW_bottle_umol`)
  ) %>%
  filter(!is.na(site), !is.na(trt), !is.na(tiempo), !is.na(stage)) %>%
  mutate(
    # un 0 en el carbono o en el 13C medido = "no medido" (celda vacia convertida en 0): no cuenta
    ok_OL = !is.na(C_OL) & !is.na(C13_OL) & C_OL > 0 & C13_OL > 0,
    ok_PW = !is.na(C_PW) & !is.na(C13_PW) & C_PW > 0 & C13_PW > 0,
    Fc = F_calc[as.character(site)]
  )

d <- d %>% mutate(
  xs_OL = C13_OL - C_OL * F_fondo,                       # exceso de 13C sobre el fondo (Viladrau)
  xs_PW = C13_PW - C_PW * F_fondo,
  D_OL = ifelse(ok_OL, xs_OL / (Fc - F_fondo), NA_real_),   # umol de CaCO3 total disuelto
  D_PW = ifelse(ok_PW, xs_PW / (Fc - F_fondo), NA_real_),
  D_Liquido = D_OL + D_PW                                # NA si falta OL o PW
)

# 0) cuantas botellas tienen dato
cat("\n--- botellas con dato por compartimento ---\n")
d %>% group_by(trt, tiempo, stage) %>%
  summarise(n = n(), OL = sum(!is.na(D_OL)), PW = sum(!is.na(D_PW)), Liquido = sum(!is.na(D_Liquido)), .groups = "drop") %>% print(n = Inf)

# 1) Delta final - media initial, por compartimento
etiq <- c(D_OL = "OL (agua suprayacente)", D_PW = "PW (agua de poro)", D_Liquido = "Total líquido (OL + PW)")
largo <- d %>% pivot_longer(c(D_OL, D_PW, D_Liquido), names_to = "comp", values_to = "D") %>%
  mutate(comp = factor(comp, levels = names(etiq), labels = unname(etiq))) %>% filter(!is.na(D))

base_I <- largo %>% filter(stage == "initial") %>%
  group_by(tiempo, site, trt, comp) %>% summarise(D_I = mean(D), .groups = "drop")
fin <- largo %>% filter(stage == "final") %>%
  left_join(base_I, by = c("tiempo", "site", "trt", "comp")) %>%
  mutate(dD = D - D_I) %>% filter(!is.na(dD))

masa_sitio <- d %>% group_by(site) %>% summarise(masa = mean(Sed_dry_g, na.rm = TRUE), .groups = "drop")

est <- largo %>% group_by(tiempo, site, trt, comp, stage) %>%
  summarise(m = mean(D), sd = sd(D), .groups = "drop") %>%
  pivot_wider(names_from = stage, values_from = c(m, sd)) %>%
  mutate(dD = m_final - m_initial, dD_sd = sqrt(sd_final^2 + sd_initial^2),
         distinguible = abs(dD) > 2 * dD_sd) %>%
  filter(!is.na(dD)) %>% left_join(masa_sitio, by = "site") %>%
  mutate(tasa_umol_g_d = dD / dias_inc / masa)

tabla <- est %>% select(trt, site, tiempo, comp, dD, dD_sd, distinguible, tasa_umol_g_d) %>% arrange(comp, trt, site, tiempo)
cat("\n--- ΔD (µmol de CaCO3 total disuelto en 24 h, por botella) ---\n")
print(tabla %>% mutate(across(c(dD, dD_sd, tasa_umol_g_d), ~ signif(.x, 3))), n = Inf)
write.csv2(tabla, "Disolucion_mi_metodo_liquida_tabla.csv", row.names = FALSE)

