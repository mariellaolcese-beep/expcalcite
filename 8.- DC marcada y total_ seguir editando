# Disolucion de calcita marcada (D) 
# Calcita MARCADA disuelta, solo parte LIQUIDA: OL, PW y total liquido (OL + PW)
#   xs [umol de 13C] = 13C - C * F_fondo
#   D  [umol de calcita marcada] = xs / (F_marcaje - F_fondo)
#   ΔD de 24 h = D de la botella final - media de D de las botellas initial (mismo sitio, tratamiento y tiempo)
# El headspace (CO2) queda FUERA hasta decidir el fondo de 13C del CO2.
# Necesita en memoria: `pl` y la funcion `num`
library(dplyr); library(tidyr); library(ggplot2); library(stringr)

F_marcaje <- 0.9999            # enriquecimiento del reactivo (99,99 %)
F_fondo   <- 0.010878323       # fondo = Viladrau, d13C = -16,3 permil (OL y PW)
dias_inc  <- 1
x_traz    <- c(A = 0.00552, B = 0.00471)   # fraccion de trazador / calcita total (para pasar a calcita total, opcional)

d <- pl %>%
  transmute(
    sample_id,
    tiempo = as.integer(str_extract(extraction_time, "\\d+")),
    stage  = factor(tolower(stage), levels = c("initial", "final")),
    trt    = factor(treatment, levels = c("Dry", "Wet")),
    site   = factor(site, levels = c("A", "B")),
    Sed_dry_g = num(Sed_init_dry_g),
    C_OL  = num(DIC_OL_bottle_mmol) * 1000,   C13_OL  = num(`13DIC_OL_bottle_umol`),   # umol
    C_PW  = num(DIC_PW_bottle_mmol) * 1000,   C13_PW  = num(`13DIC_PW_bottle_umol`)    # umol
  ) %>%
  filter(!is.na(site), !is.na(trt), !is.na(tiempo), !is.na(stage)) %>%
  # Un 0 en el carbono o en el 13C significa "no medido" (celda vacia convertida en 0 por una formula): se trata como NA
  mutate(across(c(C_OL, C13_OL, C_PW, C13_PW), ~ ifelse(.x <= 0, NA_real_, .x))) %>%
  mutate(
    xs_OL = C13_OL - C_OL * F_fondo,                    # exceso de 13C
    xs_PW = C13_PW - C_PW * F_fondo,
    D_OL  = xs_OL / (F_marcaje - F_fondo),              # calcita marcada disuelta
    D_PW  = xs_PW / (F_marcaje - F_fondo),
    D_Liquido = D_OL + D_PW                              # NA si falta OL o PW
  )

# 0) cuantas botellas tienen dato
cat("\n--- botellas con dato por compartimento ---\n")
d %>% group_by(trt, tiempo, stage) %>%
  summarise(n = n(), OL = sum(!is.na(D_OL)), PW = sum(!is.na(D_PW)), Liquido = sum(!is.na(D_Liquido)), .groups = "drop") %>% print(n = Inf)

# 1) Delta final - media initial, por compartimento
etiq <- c(D_OL = "OL (agua suprayacente)", D_PW = "PW (agua de poro)", D_Liquido = "Total líquido (OL + PW)")
largo <- d %>% pivot_longer(c(D_OL, D_PW, D_Liquido), names_to = "comp", values_to = "D") %>%
  mutate(comp = factor(comp, levels = names(etiq), labels = unname(etiq))) %>% filter(!is.na(D))

base_I <- largo %>% filter(stage == "initial") %>%
  group_by(tiempo, site, trt, comp) %>% summarise(D_I = mean(D), .groups = "drop")
fin <- largo %>% filter(stage == "final") %>%
  left_join(base_I, by = c("tiempo", "site", "trt", "comp")) %>%
  mutate(dD = D - D_I) %>% filter(!is.na(dD))

masa_sitio <- d %>% group_by(site) %>% summarise(masa = mean(Sed_dry_g, na.rm = TRUE), .groups = "drop")

est <- largo %>% group_by(tiempo, site, trt, comp, stage) %>%
  summarise(m = mean(D), sd = sd(D), n = n(), .groups = "drop") %>%
  pivot_wider(names_from = stage, values_from = c(m, sd, n)) %>%
  mutate(dD = m_final - m_initial, dD_sd = sqrt(sd_final^2 + sd_initial^2),
         distinguible = abs(dD) > 2 * dD_sd) %>%
  filter(!is.na(dD)) %>%
  left_join(masa_sitio, by = "site") %>%
  mutate(dD_calcita_total = dD / x_traz[as.character(site)],      # opcional: escala a calcita total
         tasa_umol_g_d = dD / dias_inc / masa)                    # tasa de calcita marcada

tabla <- est %>% select(trt, site, tiempo, comp, dD, dD_sd, distinguible, tasa_umol_g_d, dD_calcita_total) %>%
  arrange(comp, trt, site, tiempo)
cat("\n--- ΔD (µmol de calcita marcada disuelta en 24 h) ---\n")
print(tabla %>% mutate(across(c(dD, dD_sd, tasa_umol_g_d, dD_calcita_total), ~ signif(.x, 3))), n = Inf)
write.csv2(tabla, "Disolucion_liquida_tabla.csv", row.names = FALSE)     # para Excel / PowerPoint

# 2) Figura: un panel por compartimento (columnas) y tratamiento (filas)
col_site <- c(A = "#1A1A1A", B = "#D81B60")
dod <- position_dodge(width = 0.25)
p <- ggplot() +
  geom_hline(yintercept = 0, linetype = "dashed", colour = "grey40", linewidth = 0.4) +
  geom_point(data = fin, aes(tiempo, dD, colour = site),
             position = position_jitterdodge(jitter.width = 0.05, dodge.width = 0.25, seed = 1),
             size = 1.4, alpha = 0.5) +
  geom_line(data = est, aes(tiempo, dD, colour = site, group = site), position = dod, linewidth = 0.6) +
  geom_errorbar(data = est, aes(tiempo, ymin = dD - dD_sd, ymax = dD + dD_sd, colour = site),
                position = dod, width = 0.2, linewidth = 0.4) +
  geom_point(data = est, aes(tiempo, dD, colour = site), position = dod, shape = 18, size = 4) +
  facet_grid(trt ~ comp, scales = "free_y") +
  scale_x_continuous(breaks = 0:4, labels = paste0("t", 0:4)) +
  scale_y_continuous(labels = function(x) sprintf("%.3f", x)) +
  scale_colour_manual(values = col_site, name = "Sitio") +
  labs(x = NULL, y = "ΔD calcita marcada disuelta en 24 h (µmol)",
       title = "Disolución de calcita marcada en la parte líquida",
       caption = "xs = 13C − C × F_fondo (Viladrau, −16,3 ‰); D = xs / (F_marcaje − F_fondo), F_marcaje = 0,9999.\nPuntos = botella final − media initial; rombo = promedio; barras = SD combinada. Dry solo tiene agua en t0 (y PW parcial en t1).") +
  theme_minimal(base_size = 12) +
  theme(legend.position = "bottom", panel.grid.minor = element_blank(),
        strip.text = element_text(face = "bold"))
ggsave("Disolucion_liquida.png", p, width = 11, height = 6.5, dpi = 300)
