# Dry vs Wet en t0 (t de Welch sobre las botellas finales - media initial)
cat("\n--- t0: Dry vs Wet (t de Welch) ---\n")
t0_test <- fin %>% filter(tiempo == 0) %>% group_by(comp, site) %>% group_modify(~ {
  a <- .x$dD[.x$trt == "Dry"]; b <- .x$dD[.x$trt == "Wet"]
  if (length(a) < 2 || length(b) < 2) return(tibble(media_Dry = NA_real_, media_Wet = NA_real_, p = NA_real_))
  tibble(media_Dry = mean(a), media_Wet = mean(b), p = t.test(a, b)$p.value)
}) %>% ungroup()
print(t0_test %>% mutate(across(c(media_Dry, media_Wet), ~ signif(.x, 3)), p = round(p, 3)), n = Inf)

fin0 <- fin %>% filter(tiempo == 0); est0 <- est %>% filter(tiempo == 0)

# Tabla de t0 con Dry y Wet lado a lado (para la diapositiva): ΔD ± SD (µmol de calcita marcada en 24 h), p de Welch y p ajustada (Holm)
t0_ancho <- est0 %>%
  mutate(txt = sprintf("%.4f ± %.4f%s", dD, dD_sd, ifelse(distinguible, " *", ""))) %>%
  select(comp, site, trt, txt) %>% pivot_wider(names_from = trt, values_from = txt) %>%
  left_join(t0_test %>% mutate(p_Holm = p.adjust(p, "holm")) %>% select(comp, site, p, p_Holm), by = c("comp", "site")) %>%
  mutate(across(c(p, p_Holm), ~ round(.x, 3))) %>% arrange(comp, site)
cat("\n=== t0: Dry y Wet lado a lado (ΔD ± SD, µmol; * = distinguible del ruido) ===\n")
print(t0_ancho, n = Inf, width = Inf)
write.csv2(t0_ancho, "Disolucion_liquida_t0_Dry_vs_Wet.csv", row.names = FALSE)
