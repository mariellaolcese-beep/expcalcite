# Data folders
folder_raw <- paste0(project_root, "/Rawdata")

# Folder for Map Injection files
folder_mapinjections <- paste0(project_root, "/Map_injections")
if (!dir.exists(folder_mapinjections)) {
  dir.create(folder_mapinjections)
}

# ---- Packages & functions ----
required_pkgs <- c("tidyverse", "readxl", "lubridate")

for (pkg in required_pkgs) {
  if (!requireNamespace(pkg, quietly = TRUE)) {
    install.packages(pkg)
  }
  library(pkg, character.only = TRUE)
}

# Import functions of repository
repo_root <- dirname(rstudioapi::getSourceEditorContext()$path)
files.sources <- list.files(path = paste0(repo_root, "/functions"), full.names = TRUE)
for (f in files.sources) { source(f) }

# ---- Check rawdata files and map_injection files ----
maps_done <- list.files(path = folder_mapinjections, pattern = "^raw_.*_map_injection")
raw_files <- list.files(path = folder_raw, pattern = "^TG")

# Get raw files without corresponding map injection
raw_files_withoutmap <- raw_files[!gsub(".data", "", raw_files) %in% gsub(".csv", "", gsub("raw_.*_map_injection_", "", maps_done))]

# ---- Load planned sequence template from Excel (if present) ----
excel_map_file <- list.files(path = folder_mapinjections, pattern = "\\.xlsx$", full.names = TRUE)[1]
planned_sequence <- NULL
if (!is.na(excel_map_file)) {
  planned_sequence <- readxl::read_excel(excel_map_file)
}

# ---- Config offset ----
# Difference between REALTIME and LICORTIME (REALTIME - LICORTIME = +44 minutes)
offset_minutes <- 44

# ---- Generate maps ----
for (i in raw_files_withoutmap) {
  
  if (grepl("TG10", i)) {
    a <- read_Licor_TG10(paste0(folder_raw, "/", i))
    gas <- "CO2_and_CH4"
  }
  if (grepl("TG20", i)) {
    a <- read_Licor_TG20(paste0(folder_raw, "/", i))
    gas <- "N2O"
  }
  
  # Extract recorded remarks and shift time to REALTIME (+44 min)
  detected_map <- a %>% 
    filter(!is.na(label) & label != "") %>% 
    group_by(label) %>% 
    summarise(
      date = first(date),
      Tstart_licor = first(UTCtime),
      Tend_licor   = last(UTCtime),
      .groups = "drop"
    ) %>% 
    mutate(
      time_start_real = lubridate::ymd_hms(paste(date, Tstart_licor)) + lubridate::minutes(offset_minutes),
      time_end_real   = lubridate::ymd_hms(paste(date, Tend_licor)) + lubridate::minutes(offset_minutes),
      Tstart = format(time_start_real, "%H:%M:%S"),
      Tend   = format(time_end_real, "%H:%M:%S")
    ) %>% 
    select(date, Tstart, Tend, label) %>% 
    arrange(Tstart)
  
  # Merge with planned Excel sequence to avoid missing unrecorded initial injections
  if (!is.null(planned_sequence) && "remark" %in% colnames(planned_sequence)) {
    full_map <- planned_sequence %>% 
      select(label = remark) %>% 
      left_join(detected_map, by = "label") %>% 
      mutate(
        rawfile = i,
        date = ifelse(is.na(date), first(na.omit(detected_map$date)), date),
        Tstart_correct = Tstart,
        Tend_correct   = Tend,
        label_correct  = label,
        firstlicor_TG10_or_TG20 = ifelse(grepl("TG10", i), "TG10", "TG20")
      )
  } else {
    full_map <- detected_map %>% 
      mutate(
        rawfile = i,
        Tstart_correct = Tstart,
        Tend_correct   = Tend,
        label_correct  = label,
        firstlicor_TG10_or_TG20 = ifelse(grepl("TG10", i), "TG10", "TG20")
      )
  }
  
  # Save map injection CSV
  write.csv(full_map, file = paste0(folder_mapinjections, "/raw_", gas, "_map_injection_", gsub(".data", "", i), ".csv"), row.names = FALSE)
}

