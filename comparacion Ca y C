# =====================================================================================================
#  CO2 RATE (headspace) + CO2 y 13CO2
#
#  Qué hace:
#   Fig 1  Flujo total de CO2 (µmol C m-2 d-1)
#   Fig 2  Flujo de 13C (µmol 13C m-2 d-1)
#   Fig 3  δ13C del CO2 de cada frasco (un punto por botella)
#   Fig 4  C procedente de la calcita, estimado con 13C: TOTAL (µmol C m-2 d-1)          [NUEVO]
#   Fig 5  Lo mismo por compartimento (OL, PW, CO2)                                      [NUEVO]
#   Fig 6  Flujo de C (cambio neto) en OL, PW, CO2 y Total (µmol C m-2 d-1)              [NUEVO]
#   Fig 7  Ca neto de las aguas vs C neto de calcita (13C), mismas unidades              [NUEVO]
#   Fig 8  Dispersión Ca vs C de calcita (si solo hay disolución: sobre la línea 1:1)    [NUEVO]
#
#  Flujo =  delta = promedio de las botellas final - promedio initial   (mismo tiempo, sitio y tratamiento)
#   con SD combinada = raíz(SD_final^2 + SD_initial^2). Cada frasco usa SU volumen de headspace.
#
#  N = µmol de C totales del CO₂ (de los ppm y el volumen).
#   F es la fracción de ¹³C, que sale del δ: R = R_VPDB × (1 + δ/1000) y F = R/(1+R).
#   N13 = N × F son los µmol de ¹³C del CO₂.
# =====================================================================================================
library(tidyverse)

# -----------------------------------------------------------------------------------------------------
#  0. AJUSTES
# -----------------------------------------------------------------------------------------------------
archivo      <- "C:/Experimentcalcite/data/planilla_total.csv"
carpeta_out  <- "C:/Experimentcalcite/resultados"
codificacion <- "UTF-8"

R_VPDB       <- 0.0111802

R_gas    <- 0.0820573     # L*atm/(mol*K)
T_kelvin <- 298.15        # 25 °C
P_atm    <- 1.0
A_sedimento_m2    <- 0.00196   # r = 2,5 cm -> 19,6 cm2
incubation_time_h <- 24
dias_incubacion   <- incubation_time_h / 24   # las tasas se dan por DÍA (µmol m-2 d-1)

# --- NUEVO: disolución con 13C en las aguas (OL y PW) ---
# δ13C de la CALCITA por sitio (‰). PROVISIONAL (esperado por LOI): cambiar cuando llegue el 13PIC real.
d13C_calcita <- c(A = 446, B = 349)
d13C_resp    <- -25            # δ13C del carbono de la respiración (‰); típico de materia orgánica, NO medido
excluir_DIC_negativo <- TRUE   # un DIC negativo no existe: se trata como dato que falta
# TRUE = MISMA escala en OL, PW y CO2 (comparable entre capas: lo que piden). FALSE = cada capa con su escala (ver el detalle del CO2)
M_Ca <- 40.078                 # g/mol: ppm (mg/L) / M_Ca = mM de Ca
escala_comparable     <- TRUE
escala_y_capas        <- if (escala_comparable) "fixed" else "free_y"
mostrar_disol_capas   <- TRUE  # TRUE = dibuja la Fig 5 (C de calcita por compartimento)
mostrar_flujo_C_capas <- TRUE  # TRUE = dibuja la Fig 6 (flujo de C por compartimento)

col_D <- "#222222"   # Dry (negro)
col_W <- "#E06D9B"   # Wet (rosa medio)
col_trt <- c(Dry = col_D, Wet = col_W)
etiquetas_tiempo_todas <- c("t0\n(0d)", "t1\n(14d)", "t2\n(30d)", "t3\n(60d)", "t4\n(120d)")

# -----------------------------------------------------------------------------------------------------
#  1. LEER LA PLANILLA
# -----------------------------------------------------------------------------------------------------
num <- function(x) suppressWarnings(as.numeric(gsub(",", ".", as.character(x))))
F_desde_d <- function(d) { R <- R_VPDB * (1 + d / 1000); R / (1 + R) }

lineas <- readLines(archivo, n = 20, warn = FALSE, encoding = codificacion)
fila_header <- grep("sample_id", lineas)[1]
if (is.na(fila_header)) stop("No se encontró 'sample_id' en las primeras 20 líneas del archivo.")
linea_hdr <- lineas[fila_header]
sep <- if (grepl(";", linea_hdr)) ";" else if (grepl("\t", linea_hdr)) "\t" else ","

pl <- read_delim(archivo, delim = sep, skip = fila_header - 1,
                 col_types = cols(.default = col_character()),
                 locale = locale(encoding = codificacion), na = c("", "NA"), show_col_types = FALSE)
pl <- pl[, !grepl("^\\.\\.\\.[0-9]+$", names(pl))]

col_d_co2 <- intersect(c("13_CO2_δ", "13_CO2"), names(pl))[1]
if (is.na(col_d_co2)) stop("No encuentro la columna del δ13C del CO2 (13_CO2_δ o 13_CO2).")
faltan <- setdiff(c("sample_id", "extraction_time", "stage", "treatment", "site",
                    "CO2_corrected_ppm", "Vol_headspace_mL"), names(pl))
if (length(faltan) > 0) stop("Faltan columnas en la planilla: ", paste(faltan, collapse = ", "))

co2 <- pl %>%
  transmute(sample_id,
            TIME  = as.integer(gsub("\\D", "", extraction_time)),
            stage = factor(tolower(stage), levels = c("initial", "final")),
            trt   = factor(treatment, levels = c("Dry", "Wet")),
            site  = factor(site, levels = c("A", "B")),
            CO2_ppm = num(CO2_corrected_ppm),
            V_L     = num(Vol_headspace_mL) / 1000,
            d_CO2   = num(.data[[col_d_co2]])) %>%
  filter(!is.na(site), !is.na(trt), !is.na(TIME), !is.na(stage))

# -----------------------------------------------------------------------------------------------------
#  2. POR FRASCO: µmol de C del CO2 y µmol de 13C
# -----------------------------------------------------------------------------------------------------
co2 <- co2 %>% mutate(
  # µmol de C en el headspace = ppm x 1e-6 x (P x V) / (R x T) x 1e6 = ppm x P x V / (R x T)
  N_umol   = CO2_ppm * P_atm * V_L / (R_gas * T_kelvin),
  F_CO2    = F_desde_d(d_CO2),
  N13_umol = N_umol * F_CO2
)

cat("\nFrascos con ppm o volumen vacío:\n")
co2 %>% filter(is.na(N_umol)) %>% select(sample_id, CO2_ppm, V_L) %>% print(n = 30)
cat("\nFrascos con CO2 pero sin δ13C del CO2 (no entran en las figuras 2 y 3):\n")
co2 %>% filter(!is.na(N_umol), is.na(d_CO2)) %>% count(trt, stage, TIME) %>% print(n = 40)

# -----------------------------------------------------------------------------------------------------
#  2b. NUEVO: DIC DE LAS AGUAS (OL y PW) Y DISOLUCIÓN CON 13C, POR FRASCO
#      Mismo cálculo que en el script de la tasa de disolución:
#        ENTRADA (µmol) = concentración (mM) x volumen (mL)      FINAL (µmol) = igual, con el agua del final
#        NETO = FINAL - ENTRADA      (el CO2 no tiene entrada: su neto es lo que hay)
#        13C = C x F
#        Disolución D = (13C_neto - C_neto x F_resp) / (F_calc - F_resp)      [µmol de C que vienen de la calcita]
#      OJO: en los Dry de t1 a t4 no hay agua medida, así que OL, PW y Total quedan vacíos (el CO2 sí sale).
# -----------------------------------------------------------------------------------------------------
cols_agua <- c("DIC_OL_mM", "DIC_PW_mM", "DIC_viladrau_mM", "DIC_initial_sed_mM",
               "13DIC_viladrau_δ", "13DIC_initial_water_sed", "13DIC_OL_δ", "13DIC_PW_δ",
               "Sed_init_dry_g", "water_sed_init_mL", "g_OL", "sed_ST_g", "Vild_total_g",
               "Ca_OL_ppm", "Ca_PW_ppm", "Ca_vd_ppm", "Ca_pwsed_ppm")
faltan_agua <- setdiff(cols_agua, names(pl))
if (length(faltan_agua) > 0) stop("Faltan columnas del DIC en la planilla: ", paste(faltan_agua, collapse = ", "))

agua <- pl %>%
  transmute(sample_id,
            DIC_OL   = num(DIC_OL_mM),            DIC_PW  = num(DIC_PW_mM),
            DIC_vil  = num(DIC_viladrau_mM),      DIC_sedw = num(DIC_initial_sed_mM),
            d_vil    = num(`13DIC_viladrau_δ`),   d_sedw  = num(`13DIC_initial_water_sed`),
            d_OL     = num(`13DIC_OL_δ`),         d_PW    = num(`13DIC_PW_δ`),
            Sed_dry_g = num(Sed_init_dry_g),      V_PW_ini = num(water_sed_init_mL),
            g_OL     = num(g_OL),                 sed_ST_g = num(sed_ST_g),
            V_OL_ini = num(Vild_total_g),
            Ca_vd = num(Ca_vd_ppm), Ca_pwsed = num(Ca_pwsed_ppm),     # Ca medido (ppm = mg/L)
            Ca_OL = num(Ca_OL_ppm), Ca_PW = num(Ca_PW_ppm))

bal <- co2 %>% left_join(agua, by = "sample_id")

if (excluir_DIC_negativo) {
  neg <- bal %>% filter(DIC_OL < 0 | DIC_PW < 0) %>% select(sample_id, DIC_OL, DIC_PW)
  if (nrow(neg) > 0) { cat("\nFrascos con DIC negativo (se dejan como dato que falta):\n"); print(neg) }
  bal <- bal %>% mutate(DIC_OL = if_else(DIC_OL < 0, NA_real_, DIC_OL),
                        DIC_PW = if_else(DIC_PW < 0, NA_real_, DIC_PW))
}

# si falta el DIC o el δ del Viladrau / del agua del sedimento en un frasco, se usa la media de su grupo
bal <- bal %>%
  group_by(site, trt) %>%
  mutate(DIC_sedw = coalesce(DIC_sedw, mean(DIC_sedw, na.rm = TRUE)),
         d_sedw   = coalesce(d_sedw,   mean(d_sedw,   na.rm = TRUE)),
         Ca_pwsed = coalesce(Ca_pwsed, mean(Ca_pwsed, na.rm = TRUE))) %>%
  ungroup() %>%
  mutate(DIC_vil = coalesce(DIC_vil, mean(DIC_vil, na.rm = TRUE)),
         d_vil   = coalesce(d_vil,   mean(d_vil,   na.rm = TRUE)),
         Ca_vd   = coalesce(Ca_vd,   mean(Ca_vd,   na.rm = TRUE)))

bal <- bal %>% mutate(
  F_vil = F_desde_d(d_vil), F_sedw = F_desde_d(d_sedw), F_OL = F_desde_d(d_OL), F_PW = F_desde_d(d_PW),
  V_OL_fin = g_OL,                                   # agua suprayacente al sacrificar (mL)
  V_PW_fin = sed_ST_g - g_OL - Sed_dry_g,            # toda el agua de poro (mL): ver nota sobre este volumen
  C_in_OL  = DIC_vil  * V_OL_ini,   C_in_PW = DIC_sedw * V_PW_ini,
  # NETO de C (µmol) por compartimento
  C_OL    = DIC_OL * V_OL_fin - C_in_OL,
  C_PW    = DIC_PW * V_PW_fin - C_in_PW,
  C_CO2   = N_umol,
  C_Total = C_OL + C_PW + C_CO2,                     # NA si falta cualquiera de los tres
  # NETO de 13C (µmol)
  C13_OL    = DIC_OL * V_OL_fin * F_OL - C_in_OL * F_vil,
  C13_PW    = DIC_PW * V_PW_fin * F_PW - C_in_PW * F_sedw,
  C13_CO2   = N13_umol,
  C13_Total = C13_OL + C13_PW + C13_CO2,
  # disolución (µmol de C de calcita) por compartimento
  F_calc = unname(F_desde_d(d13C_calcita)[as.character(site)]),
  F_resp = F_desde_d(d13C_resp),
  D_OL    = (C13_OL    - C_OL    * F_resp) / (F_calc - F_resp),
  D_PW    = (C13_PW    - C_PW    * F_resp) / (F_calc - F_resp),
  D_CO2   = (C13_CO2   - C_CO2   * F_resp) / (F_calc - F_resp),
  D_Total = (C13_Total - C_Total * F_resp) / (F_calc - F_resp),
  # Ca NETO de las aguas (µmol) = FINAL - ENTRADA.  ppm / M_Ca = mM;  mM x mL = µmol.
  # Si el C de calcita solo viniera de disolución, el Ca neto debería ser igual a D_Total (1 Ca : 1 C).
  Ca_neto = (Ca_OL / M_Ca) * V_OL_fin + (Ca_PW / M_Ca) * V_PW_fin -
            (Ca_vd / M_Ca) * V_OL_ini - (Ca_pwsed / M_Ca) * V_PW_ini
)

cat("\nFrascos a los que les falta algún dato del agua (OL/PW/Total quedan vacíos), por tratamiento y tiempo:\n")
bal %>% filter(is.na(C_Total)) %>% count(trt, stage, TIME) %>% print(n = 60)

# -----------------------------------------------------------------------------------------------------
#  3. DELTA FINAL - INITIAL Y FLUJO
# -----------------------------------------------------------------------------------------------------
# delta = promedio_final - promedio_initial;  SD combinada = raíz(SD_final^2 + SD_initial^2)
# flujo = delta / (1 día x área)   [µmol m-2 d-1]
delta_flujo <- function(var, factor_unidad = 1, datos = co2) {
  datos %>% filter(!is.na(.data[[var]])) %>%
    group_by(TIME, site, trt, stage) %>%
    summarise(m = mean(.data[[var]]), sd = sd(.data[[var]]), n = n(), .groups = "drop") %>%
    pivot_wider(names_from = stage, values_from = c(m, sd, n)) %>%
    filter(!is.na(m_final), !is.na(m_initial)) %>%
    mutate(d      = m_final - m_initial,
           d_sd   = sqrt(sd_final^2 + sd_initial^2),
           flux    = factor_unidad * d    / (dias_incubacion * A_sedimento_m2),
           flux_sd = factor_unidad * d_sd / (dias_incubacion * A_sedimento_m2))
}

fl_C    <- delta_flujo("N_umol")                    # µmol C m-2 d-1
fl_13C  <- delta_flujo("N13_umol")                  # µmol 13C m-2 d-1

# NUEVO: flujo de DISOLUCIÓN y flujo de C por capa (OL, PW, CO2, Total). Misma lógica: delta final - initial / (24 h x área)
capas_D <- c(OL = "D_OL", PW = "D_PW", CO2 = "D_CO2", Total = "D_Total")
capas_C <- c(OL = "C_OL", PW = "C_PW", CO2 = "C_CO2", Total = "C_Total")
por_capa <- function(vars) {
  map_dfr(names(vars), function(k)
    delta_flujo(vars[[k]], datos = bal) %>% mutate(fuente = factor(k, levels = names(vars))))
}
fl_D  <- por_capa(capas_D)     # µmol C de calcita m-2 d-1
fl_Cc <- por_capa(capas_C)     # µmol C m-2 d-1 (cambio neto de C de cada capa)

fl_Ca <- delta_flujo("Ca_neto", datos = bal)   # µmol Ca m-2 d-1 (neto de las aguas)

cat("\nTASA DE DISOLUCIÓN ESTIMADA (µmol C m-2 d-1; modelo de dos fuentes):\n")
fl_D %>% select(TIME, site, trt, fuente, n_initial, n_final, flux, flux_sd) %>%
  arrange(fuente, trt, site, TIME) %>% print(n = Inf)

cat("\nFLUJO de C total (µmol C m-2 d-1):\n")
fl_C %>% select(TIME, site, trt, n_initial, n_final, flux, flux_sd) %>% arrange(trt, site, TIME) %>% print(n = Inf)

# -----------------------------------------------------------------------------------------------------
#  4. GRÁFICOS 
# -----------------------------------------------------------------------------------------------------
tema <- theme_bw(base_size = 13) +
  theme(plot.title = element_text(face = "bold", size = 16, hjust = 0.5),
        plot.subtitle = element_text(size = 11, hjust = 0.5, color = "gray30", margin = margin(b = 10)),
        panel.background = element_rect(fill = "white", color = NA),
        panel.grid.major = element_line(color = "gray90", linewidth = 0.5),
        panel.grid.minor = element_line(color = "gray95", linewidth = 0.25),
        panel.border = element_blank(), axis.line = element_line(color = "black", linewidth = 0.5),
        strip.background = element_rect(fill = "gray92", color = NA),
        strip.text = element_text(face = "bold", size = 12),
        axis.title = element_text(face = "bold"), axis.text = element_text(color = "black"),
        legend.position = "top")

prepara <- function(df) {
  df %>% mutate(site = factor(site, levels = c("A", "B"), labels = c("Site Low OM", "Site High OM")),
                time_factor = factor(TIME, levels = 0:4, labels = etiquetas_tiempo_todas),
                treatment = trt)
}

barras_flujo <- function(df, ylab, titulo, subtitulo, extra_facet = NULL, escalas = "free_y") {
  p <- ggplot(prepara(df), aes(x = time_factor, y = flux, fill = treatment, group = treatment)) +
    geom_hline(yintercept = 0, color = "grey60", linewidth = 0.3) +
    geom_col(position = position_dodge(width = 0.7), width = 0.45, alpha = 0.9) +
    geom_errorbar(aes(ymin = flux - flux_sd, ymax = flux + flux_sd), position = position_dodge(width = 0.7),
                  width = 0.15, linewidth = 0.5, color = "black", na.rm = TRUE) +
    scale_x_discrete(limits = etiquetas_tiempo_todas, drop = FALSE) +
    scale_fill_manual(values = col_trt, name = "Treatment", drop = FALSE) +
    labs(title = titulo, subtitle = subtitulo, x = "Time", y = ylab) + tema
  if (is.null(extra_facet)) p + facet_wrap(~ site) else p + facet_grid(fuente ~ site, scales = escalas)
}

p_co2 <- barras_flujo(fl_C,
                      expression(bold("CO"[2]*" Flux ["*mu*"mol C m"^-2*" d"^-1*"]")),
                      expression(bold("CO"[2]*" Efflux Rate (Headspace)")),
                      "Bars: mean final - mean initial (24 h) ± combined SD")

p_13 <- barras_flujo(fl_13C,
                     expression(bold(""^13*"C Flux ["*mu*"mol "^13*"C m"^-2*" d"^-1*"]")),
                     expression(bold(""^13*"CO"[2]*" Efflux Rate (Headspace)")),
                     "Bars: mean final - mean initial (24 h) ± combined SD; only bottles with δ13C of the CO2")

# FIGURA DE PUNTOS: δ13C del CO2 de CADA frasco (initial vacío, final lleno), como el gráfico de puntos del DIC.
