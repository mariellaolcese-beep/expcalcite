  scale_y_continuous(labels = function(x) sprintf("%.4f", x)) +
  scale_colour_manual(values = col_site, name = "Sitio") +
  labs(x = NULL, y = "ΔD calcita marcada en el CO2\n(µmol en 24 h)", title = "Parte 1: ΔD del CO2, Dry vs Wet",
       caption = "Headspace. Puntos = botellas finales − media initial; rombo = promedio; barras = SD. Fondo de 13C del CO2 provisional (−25 ‰).") + tema
