# Analisis de disolucion y sequia (Dry vs Wet), tres partes en un solo script
#   Parte 1: test formal Dry vs Wet sobre el ΔD del CO2 (modelo por botella + t de Welch por grupo)
#   Parte 2: fraccion del CO2 que viene de la calcita (ΔD / CO2 total), que no depende de cuanta respiracion haya
#   Parte 3: Dry vs Wet en t0 y t1 en los compartimentos con agua (OL, PW, Total), metodo del tutor
# Necesita en memoria lo mismo que los otros scripts: `pl` y la funcion `num`
library(dplyr); library(tidyr); library(ggplot2); library(stringr)

F_marcaje <- 0.9999
fondo_de_delta <- function(d) { R <- 0.0111802 * (1 + d/1000); R / (1 + R) }
F_fondo_CO2   <- fondo_de_delta(-25)                       # CO2: respiracion + aire, PROVISIONAL (-25 permil)
F_fondo_agua  <- 0.010878323                               # OL y PW: Viladrau (-16,3 permil)
escala_total  <- 1     # 1 = solo calcita marcada. Para estimar calcita total, pon ~200 (A) y mira la nota de la Parte 2

col_site <- c(A = "#1A1A1A", B = "#D81B60"); dod <- position_dodge(width = 0.25)
tema <- theme_minimal(base_size = 12) +
  theme(legend.position = "bottom", panel.grid.minor = element_blank(), strip.text = element_text(face = "bold"))

# ---- datos por botella (los tres compartimentos) ----------------------------------------------------------
d <- pl %>%
  transmute(
    sample_id,
    tiempo = as.integer(str_extract(extraction_time, "\\d+")),
    stage  = factor(tolower(stage), levels = c("initial", "final")),
    trt    = factor(treatment, levels = c("Dry", "Wet")),
    site   = factor(site, levels = c("A", "B")),
    C_OL  = num(DIC_OL_bottle_mmol) * 1000, C13_OL  = num(`13DIC_OL_bottle_umol`),
    C_PW  = num(DIC_PW_bottle_mmol) * 1000, C13_PW  = num(`13DIC_PW_bottle_umol`),
    CO2_umol = num(`mmol de CO2`) * 1000,   C13_CO2 = num(`13CO2_umol`)
  ) %>%
  filter(!is.na(site), !is.na(trt), !is.na(tiempo), !is.na(stage)) %>%
  mutate(
    D_OL  = (C13_OL  - C_OL  * F_fondo_agua) / (F_marcaje - F_fondo_agua),
    D_PW  = (C13_PW  - C_PW  * F_fondo_agua) / (F_marcaje - F_fondo_agua),
    D_CO2 = (C13_CO2 - CO2_umol * F_fondo_CO2) / (F_marcaje - F_fondo_CO2),
    D_Total = D_OL + D_PW + D_CO2                           # NA si falta algun compartimento
  )

# ΔD de cada botella final = D - media de las initial (mismo sitio, tiempo, tratamiento)
delta <- function(dat, col) {
  dat <- dat %>% mutate(D = .data[[col]]) %>% filter(!is.na(D))
  base_I <- dat %>% filter(stage == "initial") %>% group_by(tiempo, site, trt) %>%
    summarise(D_I = mean(D), .groups = "drop")
  dat %>% filter(stage == "final") %>% left_join(base_I, by = c("tiempo", "site", "trt")) %>%
    mutate(dD = D - D_I) %>% filter(!is.na(dD))
}

# t de Welch Dry vs Wet para un data.frame con columnas trt y y (devuelve NA si no hay n>=2 en los dos)
welch <- function(df) {
  a <- df$y[df$trt == "Dry"]; b <- df$y[df$trt == "Wet"]
  if (sum(!is.na(a)) < 2 || sum(!is.na(b)) < 2) return(tibble(n_Dry = sum(!is.na(a)), n_Wet = sum(!is.na(b)),
                                                             media_Dry = NA_real_, media_Wet = NA_real_, p = NA_real_))
  tibble(n_Dry = sum(!is.na(a)), n_Wet = sum(!is.na(b)), media_Dry = mean(a, na.rm = TRUE),
         media_Wet = mean(b, na.rm = TRUE), p = t.test(a, b)$p.value)
}

