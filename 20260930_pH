### ============================================================================
### 1. LIBRARY LOADING & DATA PREPARATION
### ============================================================================

library(dplyr)
library(tidyr)
library(car)
library(emmeans)
library(ggplot2)

# Load ph_data.csv
# Assuming ph_data.csv exists in the working directory.
ph_data <- read.csv("ph_data.csv", header = TRUE, sep = ",")

# Clean and structure general data
ph_clean <- ph_data %>%
  rename(
    SITE = site..A.B.,
    TREATMENT = treatment..D.W.,
    TIME = tiempo..t0.etc.,
    STAGE = sacrificio.I.F
  ) %>%
  pivot_longer(
    cols = c(pH_OL, pH_PW),
    names_to = "LAYER",
    values_to = "pH"
  ) %>%
  mutate(
    LAYER = ifelse(LAYER == "pH_OL", "OL", "PW"),
    SITE = as.factor(SITE),
    TREATMENT = as.factor(TREATMENT),
    TIME = as.factor(TIME)
  )

site_labels <- c(A = "High OM", B = "Low OM")
treatment_labels <- c(D = "Dry", W = "Wet")

### ============================================================================
### 2. GENERAL OVERVIEW: ALL DATA (GLOBAL)
### ============================================================================

# --- 2.1 Graph 1: pH Evolution over Time (Line) ---
cat("\n--- Generating Global Graph 1: pH Evolution (Line) ---\n")

plot_ph_lineas_global <- ggplot(ph_clean %>% filter(!is.na(pH)), 
                                aes(x = TIME, y = pH, color = LAYER, group = LAYER)) +
  stat_summary(fun = mean, geom = "line", linewidth = 0.9) +
  stat_summary(fun = mean, geom = "point", size = 2.5) +
  stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2) +
  facet_grid(SITE ~ TREATMENT, labeller = labeller(SITE = site_labels, TREATMENT = treatment_labels)) +
  scale_color_manual(values = c("OL" = "black", "PW" = "gray50")) +
  labs(
    title = "Temporal evolution of pH",
    x = "Time (days)",
    y = "pH",
    color = "Layer"
  ) +
  theme_bw() +
  theme(
    plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
    plot.subtitle = element_text(size = 11, hjust = 0.5),
    axis.title = element_text(face = "bold"),
    legend.position = "bottom",
    strip.background = element_rect(fill = "#f0f0f0")
  )

print(plot_ph_lineas_global)

# --- 2.2 Graph 2: Individual pH Measurements (Points) ---
cat("\n--- Generating Global Graph 2: Individual pH Measurements (Points) ---\n")

plot_ph_puntos_global <- ggplot(ph_clean %>% filter(!is.na(pH)), 
                                aes(x = TIME, y = pH, color = LAYER)) +
  geom_point(
    position = position_jitterdodge(jitter.width = 0.15, dodge.width = 0.4),
    size = 2.5, 
    alpha = 0.8
  ) +
  facet_grid(SITE ~ TREATMENT, labeller = labeller(SITE = site_labels, TREATMENT = treatment_labels)) +
  scale_color_manual(values = c("OL" = "black", "PW" = "gray50")) +
  labs(
    title = "Temporal evolution of pH",
    x = "Time (days)",
    y = "pH",
    color = "Layer (LAYER)"
  ) +
  theme_bw() +
  theme(
    plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
    plot.subtitle = element_text(size = 11, hjust = 0.5),
    axis.title = element_text(face = "bold"),
    legend.position = "bottom",
    strip.background = element_rect(fill = "#f0f0f0")
  )

print(plot_ph_puntos_global)


### ============================================================================
### 3. ETAPA INICIAL (STAGE == 'I')
### ============================================================================

# --- 3.1 Filtrado de datos ---
ph_inicial <- ph_clean %>%
  filter(STAGE == "I" & !is.na(pH))

ph_inicial_W <- ph_inicial %>% 
  filter(TREATMENT == "W")

# --- 3.2 Análisis Estadístico: Normalidad (Shapiro-Wilk) ---
shapiro_inicial <- ph_inicial %>%
  group_by(SITE, LAYER, TREATMENT, TIME) %>%
  summarise(
    n = n(),
    W = ifelse(n >= 3, shapiro.test(pH)$statistic, NA),
    p_value = ifelse(n >= 3, shapiro.test(pH)$p.value, NA),
    .groups = "drop"
  ) %>%
  mutate(Normal = ifelse(p_value > 0.05, "SÍ", "NO"))

cat("\n--- Shapiro-Wilk Por Subgrupo (STAGE = 'I') ---\n")
print(as.data.frame(shapiro_inicial))

# --- 3.3 Homocedasticidad (Levene) por Capa ---
cat("\n--- Prueba de Levene (STAGE = 'I') ---\n")
levene_OL_ini <- leveneTest(pH ~ SITE * TREATMENT * TIME, data = filter(ph_inicial, LAYER == "OL"))
levene_PW_ini <- leveneTest(pH ~ SITE * TREATMENT * TIME, data = filter(ph_inicial, LAYER == "PW"))

cat("Agua Sobrenadante (OL) - p-value:", levene_OL_ini$`Pr(>F)`[1], "\n")
cat("Agua de Poro (PW)        - p-value:", levene_PW_ini$`Pr(>F)`[1], "\n")

# --- 3.4 Modelos ANOVA y Post-Hoc (Tratamiento W) ---
cat("\n>>> OL (Tratamiento W) - Inicial <<<\n")
mod_OL_W_ini <- aov(pH ~ SITE * TIME, data = filter(ph_inicial_W, LAYER == "OL"))
print(summary(mod_OL_W_ini))

cat("\n--- Tukey (TIME) en OL (W) - Inicial ---\n")
tukey_OL_W_ini <- emmeans(mod_OL_W_ini, pairwise ~ TIME, adjust = "tukey")
print(tukey_OL_W_ini$contrasts)

cat("\n>>> PW (Tratamiento W) - Inicial <<<\n")
mod_PW_W_ini <- aov(pH ~ SITE * TIME, data = filter(ph_inicial_W, LAYER == "PW"))
print(summary(mod_PW_W_ini))

cat("\n--- Tukey (TIME) en PW (W) - Inicial ---\n")
tukey_PW_W_ini <- emmeans(mod_PW_W_ini, pairwise ~ TIME, adjust = "tukey")
print(tukey_PW_W_ini$contrasts)

# --- 3.5 Visualización de Tratamiento W (Etapa Inicial 'I') ---
cat("\n--- Generando Gráficos: Etapa Inicial (STAGE I - W) ---\n")

# Gráfico 1: Líneas de medias ± error estándar
