  scale_color_manual(values = c("OL" = "#1f77b4", "PW" = "#ff7f0e")) +
  labs(
    title = "Cambio en el pH (ΔpH = Final - Inicial) - Tratamiento W",
    subtitle = "Diferencia entre Etapa Final e Inicial para OL (Agua Sobrenadante) y PW (Agua de Poro)",
    x = "Tiempo",
    y = "ΔpH (Final - Inicial)",
    color = "Capa (LAYER)"
  ) +
  theme_bw() +
  theme(
    plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
