### ----------------------------------------------------------------------------
### 1. CARGA DE LIBRERÍAS Y DATOS
### ----------------------------------------------------------------------------
library(dplyr)
library(tidyr)
library(car)
library(emmeans)
library(ggplot2)

# Cargar el archivo ph_data.csv
ph_data <- read.csv("ph_data.csv", header = TRUE, sep = ",")

# Limpieza y estructuración general
ph_clean <- ph_data %>%
  rename(
    SITE = site..A.B.,
    TREATMENT = treatment..D.W.,
    TIME = tiempo..t0.etc.,
    STAGE = sacrificio.I.F
  ) %>%
  pivot_longer(
    cols = c(pH_OL, pH_PW),
    names_to = "LAYER",
    values_to = "pH"
  ) %>%
  mutate(
    LAYER = ifelse(LAYER == "pH_OL", "OL", "PW"),
    SITE = as.factor(SITE),
    TREATMENT = as.factor(TREATMENT),
    TIME = as.factor(TIME)
  )

### ----------------------------------------------------------------------------
### 2. PARTE I: ANÁLISIS DE LA ETAPA INICIAL (STAGE == 'I')
### ----------------------------------------------------------------------------
cat("=========================================================\n")
cat("            ETAPA INICIAL (STAGE = 'I')                  \n")
cat("=========================================================\n\n")

# A. Filtrar objeto inicial (resuelve el error 'ph_inicial not found')
ph_inicial <- ph_clean %>%
  filter(STAGE == "I" & !is.na(pH))

# B. Normalidad (Shapiro-Wilk) - Etapa Inicial
shapiro_inicial <- ph_inicial %>%
  group_by(SITE, LAYER, TREATMENT, TIME) %>%
  summarise(
    n = n(),
    W = ifelse(n >= 3, shapiro.test(pH)$statistic, NA),
    p_value = ifelse(n >= 3, shapiro.test(pH)$p.value, NA),
    .groups = "drop"
  ) %>%
  mutate(Normal = ifelse(p_value > 0.05, "SÍ", "NO"))

cat("--- Shapiro-Wilk Por Subgrupo (STAGE = 'I') ---\n")
print(as.data.frame(shapiro_inicial))

# C. Homocedasticidad (Levene) por Capa - Etapa Inicial
cat("\n--- Prueba de Levene (STAGE = 'I') ---\n")
levene_OL_ini <- leveneTest(pH ~ SITE * TREATMENT * TIME, data = filter(ph_inicial, LAYER == "OL"))
levene_PW_ini <- leveneTest(pH ~ SITE * TREATMENT * TIME, data = filter(ph_inicial, LAYER == "PW"))

cat("Agua Sobrenadante (OL) - p-value:", levene_OL_ini$`Pr(>F)`[1], "\n")
cat("Agua de Poro (PW)       - p-value:", levene_PW_ini$`Pr(>F)`[1], "\n\n")

# D. Modelos ANOVA y Post-Hoc en Tratamiento W - Etapa Inicial
cat(">>> OL (Tratamiento W) - Inicial <<<\n")
ph_OL_W_ini <- filter(ph_inicial, LAYER == "OL" & TREATMENT == "W")
mod_OL_W_ini <- aov(pH ~ SITE * TIME, data = ph_OL_W_ini)
print(summary(mod_OL_W_ini))

cat("\n--- Tukey (TIME) en OL (W) ---\n")
tukey_OL_W_ini <- emmeans(mod_OL_W_ini, pairwise ~ TIME, adjust = "tukey")
print(tukey_OL_W_ini$contrasts)

cat("\n>>> PW (Tratamiento W) - Inicial <<<\n")
ph_PW_W_ini <- filter(ph_inicial, LAYER == "PW" & TREATMENT == "W")
mod_PW_W_ini <- aov(pH ~ SITE * TIME, data = ph_PW_W_ini)
print(summary(mod_PW_W_ini))

cat("\n--- Tukey (TIME) en PW (W) ---\n")
tukey_PW_W_ini <- emmeans(mod_PW_W_ini, pairwise ~ TIME, adjust = "tukey")
print(tukey_PW_W_ini$contrasts)

=========================================================
   GENERACIÓN DE GRÁFICO DE pH POR TIEMPO//EL BASICO 
=========================================================

# Gráfico de líneas (media ± error estándar) y puntos para la evolución del pH
plot_ph_tiempo <- ggplot(ph_clean %>% filter(!is.na(pH)), 
                         aes(x = TIME, y = pH, color = LAYER, group = LAYER)) +
  stat_summary(fun = mean, geom = "line", linewidth = 0.9) +
  stat_summary(fun = mean, geom = "point", size = 2.5) +
  stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2) +
  facet_grid(SITE ~ TREATMENT, labeller = label_both) +
  scale_color_manual(values = c("OL" = "#1f77b4", "PW" = "#ff7f0e")) +
  labs(
    title = "Evolución del pH a través del Tiempo",
    subtitle = "Comparación entre OL (Agua Sobrenadante) y PW (Agua de Poro)",
    x = "Tiempo",
    y = "pH",
    color = "Capa (LAYER)"
  ) +
  theme_bw() +
  theme(
    plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
    plot.subtitle = element_text(size = 11, hjust = 0.5),
    axis.title = element_text(face = "bold"),
    legend.position = "bottom",
    strip.background = element_rect(fill = "#f0f0f0")
  )

# Mostrar el gráfico en pantalla
print(plot_ph_tiempo)

