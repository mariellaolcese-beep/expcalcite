
### ============================================================================
### 1. CARGA DE LIBRERÍAS Y PREPARACIÓN DE DATOS (CO2 - HEADSPACE)
### ============================================================================

library(dplyr)
library(tidyr)
library(car)
library(emmeans)
library(ggplot2)

# Cargar archivo CSV
co2_data <- read.csv(
  "CO2_0110.csv",
  header = TRUE,
  sep = ",",
  dec = ".",
  check.names = FALSE
)

# Normalizar nombres de columnas a minúsculas
names(co2_data) <- tolower(names(co2_data))

# Preparar datos
co2_clean <- co2_data %>%
  select(
    time = matches("time"),
    sample,
    co2_corrected_ppm = matches("co2_corrected_ppm")
  ) %>%
  mutate(
    
    # --------------------------------------------------------------------------
    # CO2
    # --------------------------------------------------------------------------
    # Convertir CO2 a numérico
    CO2 = as.numeric(
      gsub(",", ".", as.character(co2_corrected_ppm))
    ),
    
    # --------------------------------------------------------------------------
    # STAGE
    # --------------------------------------------------------------------------
    # Extraer I/F de los nombres de muestra
    STAGE = as.factor(
      sub("^T\\d+([IF]).*", "\\1", sample)
    ),
    
    # --------------------------------------------------------------------------
    # SITE
    # --------------------------------------------------------------------------
    # Extraer A/B
    SITE = ifelse(
      grepl("-[A-Za-z]{2}\\d", sample),
      sub(".*-([A-Za-z])[A-Za-z]\\d.*", "\\1", sample),
      sub(".*-([A-Za-z])\\d.*", "\\1", sample)
    ),
    
    # Recodificar:
    # A = Low OM
    # B = High OM
    SITE = factor(
      SITE,
      levels = c("A", "B"),
      labels = c("Low OM", "High OM")
    ),
    
    # --------------------------------------------------------------------------
    # TREATMENT
    # --------------------------------------------------------------------------
    # Extraer D/W
    TREATMENT = ifelse(
      grepl("-[A-Za-z]{2}\\d", sample),
      sub(".*-[A-Za-z]([A-Za-z])\\d.*", "\\1", sample),
      sub(".*-([A-Za-z])\\d.*", "\\1", sample)
    ),
    
    # Recodificar:
    # D = Dry
    # W = Wet
    TREATMENT = factor(
      TREATMENT,
      levels = c("D", "W"),
      labels = c("Dry", "Wet")
    ),
    
    # --------------------------------------------------------------------------
    # TIME
    # --------------------------------------------------------------------------
    TIME = as.factor(time)
    
  ) %>%
  filter(!is.na(CO2))


### ============================================================================
### 2. COMPROBACIÓN RÁPIDA DE LOS GRUPOS
### ============================================================================

cat("\n--- Grupos encontrados ---\n")

print(
  table(
    co2_clean$SITE,
    co2_clean$TREATMENT,
    useNA = "ifany"
  )
)


### ============================================================================
### 3. GRÁFICO 1: EVOLUCIÓN DEL CO2 (MEDIAS ± SE)
### ============================================================================

cat("\n--- Generando Gráfico 1: Evolución del CO2 ---\n")

plot_co2_lineas_global <- ggplot(
  co2_clean,
  aes(
    x = TIME,
    y = CO2,
    group = 1
  )
) +
  
  # Media
  stat_summary(
    fun = mean,
    geom = "line",
    linewidth = 0.9
  ) +
  
  # Puntos de la media
  stat_summary(
    fun = mean,
    geom = "point",
    size = 2.5
  ) +
  
  # Error estándar
  stat_summary(
    fun.data = mean_se,
    geom = "errorbar",
    width = 0.2
  ) +
  
  # Facetas: OM × tratamiento
  facet_grid(
    SITE ~ TREATMENT
  ) +
  
  labs(
    title = "CO₂ concentration over time",
    subtitle = "Headspace (HS)",
    x = "Time",
    y = expression(paste(CO[2], " (ppm)"))
  ) +
  
  theme_bw() +
  
  theme(
    plot.title = element_text(
      face = "bold",
      size = 14,
      hjust = 0.5
    ),
    plot.subtitle = element_text(
      size = 11,
      hjust = 0.5
    ),
    axis.title = element_text(
      face = "bold"
    ),
    strip.background = element_rect(
      fill = "#f0f0f0"
    ),
    strip.text = element_text(
      face = "bold"
    )
  )

print(plot_co2_lineas_global)


